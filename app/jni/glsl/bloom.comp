#version 460
/* v13.1 · 泛光亮部提取 + 加权模糊（1/2 分辨率输出）
 * 输入：主渲染的存储图像 imgScene（全分辨率，rgba8 storage ✓ 用 imageLoad 读，无需 sampler ✓）
 * 输出：imgBloom（1/2 分辨率 ✓ 省一半带宽 ✓）
 * 施工单：真泛光-施工单.md —— 本趟 = 其中的 bloom_pre（亮部提取）与单趟模糊的合并版 ✓
 * push constant：x=阈值x100  y=半径  z=源宽  w=源高 */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba8) readonly uniform image2D srcImg;
layout(set = 0, binding = 1, rgba8) uniform image2D dstImg;
layout(push_constant) uniform BP { ivec4 p; } bp;

void main() {
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    ivec2 ssz = ivec2(bp.p.z, bp.p.w);
    if (dst.x < 0 || dst.y < 0 || dst.x * 2 >= ssz.x || dst.y * 2 >= ssz.y) return;
    int R = bp.p.y < 1 ? 1 : (bp.p.y > 6 ? 6 : bp.p.y);
    float thr = float(bp.p.x) / 100.0;
    vec3 acc = vec3(0.0);
    float wsum = 0.0;
    for (int dy = -R; dy <= R; dy++) {
        for (int dx = -R; dx <= R; dx++) {
            ivec2 sp = ivec2(dst.x * 2 + dx, dst.y * 2 + dy);
            if (sp.x < 0 || sp.y < 0 || sp.x >= ssz.x || sp.y >= ssz.y) continue;
            vec3 c = imageLoad(srcImg, sp).rgb;
            float lum = dot(c, vec3(0.30, 0.60, 0.10));
            float k = lum - thr;
            if (k <= 0.0) continue;
            float w = 1.0 / (1.0 + float(dx * dx + dy * dy));
            acc += c * k * w;
            wsum += w;
        }
    }
    if (wsum > 0.0) acc /= wsum;
    imageStore(dstImg, dst, vec4(acc, 1.0));
}
