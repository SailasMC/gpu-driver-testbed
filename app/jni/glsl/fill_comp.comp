#version 450
// 计算峰值（FMA 阶梯）：每 invocation = iters × 4 分量 × 2 FLOP = 8·iters FLOP
// 口径：GFLOPS = 工作组数 × 64 × iters × 8 ÷ GPU 秒 ÷ 1e9
// 接口契约：local_size_x=64；push constant offset 0 size 4 int iters；SSBO set=0 binding=0（float[]，≥ 64×组数 个 float）
layout(local_size_x = 64) in;
layout(push_constant) uniform PC { int iters; } pc;
layout(std430, binding = 0) buffer Out { float data[]; } outbuf;
void main() {
    uint gid = gl_GlobalInvocationID.x;
    vec4 a = vec4(float(gid) * 1e-7, 1.0, 2.0, 3.0);
    for (int i = 0; i < pc.iters; ++i) {
        a = fma(a, vec4(1.000001), vec4(1e-7));      // 4 FMA = 8 FLOP
    }
    outbuf.data[gid] = a.x + a.y + a.z + a.w;        // 防止整段被优化掉
}
